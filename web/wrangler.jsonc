// Configuration déclarative du Worker (source de vérité GitOps).
// Top-level = développement local ; env.staging / env.production = déployés par la CI uniquement.
// Les clés non héritées (vars, d1_databases, ratelimits) sont répétées dans chaque environnement.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokedex-kanto",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build:client" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAIL": "",
    "CI_SERVICE_TOKEN_ID": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokedex-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "env": {
    "staging": {
      // workers.dev sert aux smoke tests de la CI (hors Bot Fight Mode de veltis.be) ;
      // il est couvert par la même application Access que le domaine personnalisé.
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "ACCESS_TEAM": "glowandcare",
        "ACCESS_AUD": "7e0333d29926fc500de815031c0ddbd891fbdb8f04e650834fddea8156186c3a",
        "ALLOWED_EMAIL": "terence.leclercq@veltis.be",
        "CI_SERVICE_TOKEN_ID": "47487786e10d69127cd8ed23a6412e14.access",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pokedex-staging",
          "database_id": "c156c19d-5e16-4404-8635-151c1dee6304",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }],
      "routes": [{ "pattern": "pokedex-staging.veltis.be", "custom_domain": true }],
      "triggers": { "crons": ["*/30 * * * *"] },
    },
    "production": {
      // workers.dev sert aux smoke tests de la CI (hors Bot Fight Mode de veltis.be) ;
      // il est couvert par la même application Access que le domaine personnalisé.
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        "ACCESS_TEAM": "glowandcare",
        "ACCESS_AUD": "7482661f7535422157e50a85bd40fdc5887dc4073f03de128e5b3b9db5b0854a",
        "ALLOWED_EMAIL": "terence.leclercq@veltis.be",
        "CI_SERVICE_TOKEN_ID": "47487786e10d69127cd8ed23a6412e14.access",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pokedex",
          "database_id": "f46bde96-7cf0-4689-8e6e-93086a8a9e21",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }],
      "routes": [{ "pattern": "pokedex.veltis.be", "custom_domain": true }],
      "triggers": { "crons": ["*/30 * * * *"] },
    },
  },
}
