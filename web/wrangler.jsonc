// Configuration déclarative du Worker (source de vérité GitOps).
// Top-level = développement local ; env.staging / env.production = déployés par la CI uniquement.
// Les clés non héritées (vars, d1_databases, ratelimits) sont répétées dans chaque environnement.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokedex-kanto",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm run build:client" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAIL": "",
    "CI_SERVICE_TOKEN_ID": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokedex-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "env": {
    "staging": {
      // Compte Cloudflare « pokemon » : servi sur workers.dev, protégé par une application Access.
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "staging",
        "ACCESS_TEAM": "weathered-sun-382a",
        "ACCESS_AUD": "9f3e565bf4ee9630b02345f64ed86d55ac8f9566084abfd539826e0cefc6a44c",
        "ALLOWED_EMAIL": "terence.leclercq@veltis.be",
        "CI_SERVICE_TOKEN_ID": "5dd7b0b8ae04e81785cd25e2e4df4835.access",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pokedex-staging",
          "database_id": "365ae9f6-79af-4a1a-9c4a-21a88805f7f2",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }],
      "triggers": { "crons": ["*/30 * * * *"] },
    },
    "production": {
      // Compte Cloudflare « pokemon » : servi sur workers.dev, protégé par une application Access.
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        "ACCESS_TEAM": "weathered-sun-382a",
        "ACCESS_AUD": "32b7e972e3ade97bff353e72ac68f74189a22f5953375d77913f959c8fa90bfd",
        "ALLOWED_EMAIL": "terence.leclercq@veltis.be",
        "CI_SERVICE_TOKEN_ID": "5dd7b0b8ae04e81785cd25e2e4df4835.access",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pokedex",
          "database_id": "d09ef417-faf3-4f20-a904-8fc72f96ea6f",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }],
      "triggers": { "crons": ["*/30 * * * *"] },
    },
  },
}
