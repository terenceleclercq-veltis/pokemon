{
  "name": "pokedex-kanto",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:client": "esbuild src/client/main.ts --bundle --minify --format=esm --target=es2022 --sourcemap=linked --outfile=public/app.js && esbuild src/client/placeholders.ts --bundle --minify --format=esm --target=es2022 --sourcemap=linked --outfile=public/placeholders.js",
    "dev": "wrangler dev --var DEV_BYPASS_AUTH:1",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "hono": "4.13.14",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261029.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsonc-parser": "3.3.1",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true
  },
  "packageManager": "npm@11.21.1"
}
